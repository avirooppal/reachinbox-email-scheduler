# ==========================================
# Database & Infrastructure
# ==========================================
# Postgres connection URL (default port 5434 in docker-compose to avoid host conflicts)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5434/email_scheduler?schema=public

# Redis connection URL (must have AOF enabled)
REDIS_URL=redis://localhost:6379

# Elasticsearch endpoint
ELASTICSEARCH_URL=http://localhost:9200

# Server HTTP Port
PORT=4000
NODE_ENV=development

# ==========================================
# Worker & Scheduler Configuration
# ==========================================
# Concurrency per worker instance
WORKER_CONCURRENCY=5

# Default minimum delay (gap) between emails per sender in milliseconds
MIN_DELAY_BETWEEN_EMAILS_MS=2000

# Default hourly cap per sender
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# Global hourly cap across all senders (0 = disabled)
MAX_EMAILS_PER_HOUR_GLOBAL=0

# Rate limiter algorithm: 'fixed' (window boundary) or 'sliding' (precise rolling sorted set)
RATE_LIMIT_MODE=fixed

# Percentage of jitter added to inter-email gaps (0 to 100)
JITTER_PCT=15

# Retry configuration for BullMQ jobs
JOB_ATTEMPTS=3
JOB_BACKOFF_MS=5000

# Stale processing threshold in milliseconds before job is considered abandoned
STALE_PROCESSING_MS=120000

# ==========================================
# Circuit Breaker & Failover
# ==========================================
BREAKER_FAILURES=5
BREAKER_WINDOW_MS=60000
BREAKER_COOLDOWN_MS=120000

# Enable fault injection testing endpoints (never enable in production)
ENABLE_FAULT_INJECTION=false

# ==========================================
# Security & Authentication
# ==========================================
# 32-byte hex key for JWT signing
JWT_SECRET=replace_with_32_byte_hex_secret

# 32-byte hex key for AES-256-GCM encryption at rest (passwords, tokens)
ENCRYPTION_KEY=replace_with_32_byte_hex_key

# Frontend application URL for CORS and OAuth redirects
FRONTEND_URL=http://localhost:3000

# Comma-separated list of emails allowed to view Bull Board and admin endpoints
ADMIN_EMAILS=admin@example.com,test@example.com

# ==========================================
# OAuth Integrations (Google & Slack)
# ==========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/integrations/slack/callback
