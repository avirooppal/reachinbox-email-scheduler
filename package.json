{
  "name": "email-scheduler-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix backend install --include=dev && npm --prefix frontend install --include=dev",
    "build": "npm run install:all && npm --prefix backend run migrate && npm --prefix backend run build && npm --prefix frontend run build",
    "start": "node backend/dist/server.js",
    "migrate": "npm --prefix backend run migrate",
    "seed": "npm --prefix backend run seed",
    "dev:api": "npm --prefix backend run dev:api",
    "dev:worker": "npm --prefix backend run dev:worker",
    "test": "npm --prefix backend run test",
    "audit": "npm --prefix backend run audit",
    "simulate": "npm --prefix backend run simulate",
    "chaos": "npm --prefix backend run chaos",
    "load": "npm --prefix backend run load",
    "verify": "npm --prefix backend run verify"
  }
}
