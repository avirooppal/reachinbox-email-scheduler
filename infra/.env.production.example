# ==============================================================================
# Outbox Production Environment Configuration Template
# Generate secret values using: bash infra/scripts/gen-secrets.sh
# Restrict file permissions: chmod 600 .env.production
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Host & Routing Configuration
# ------------------------------------------------------------------------------
# Fully qualified public domain name (A record pointing to server IP)
DOMAIN=app.example.com

# Target public frontend origin for CORS, cookies, and OAuth redirects
FRONTEND_URL=https://${DOMAIN}

# Express trust proxy level (1 behind single Caddy edge proxy)
TRUST_PROXY=1

# Fixed environment identifier (forces strict production safety assertions)
NODE_ENV=production

# Let's Encrypt / ZeroSSL certificate expiry and renewal notifications
ACME_EMAIL=admin@example.com

# ------------------------------------------------------------------------------
# 2. Database & State Storage
# ------------------------------------------------------------------------------
# Strong generated password for postgresql role 'app'
POSTGRES_PASSWORD=replace_with_generated_strong_postgres_password

# Internal connection URL to PostgreSQL container
DATABASE_URL=postgresql://app:${POSTGRES_PASSWORD}@postgres:5432/scheduler

# Strong generated password for Redis AUTH
REDIS_PASSWORD=replace_with_generated_strong_redis_password

# Internal connection URL to Redis container
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# Internal connection URL to Elasticsearch cluster
ELASTICSEARCH_URL=http://elasticsearch:9200

# Directory inside container for attachment storage
UPLOAD_DIR=/app/uploads

# ------------------------------------------------------------------------------
# 3. Cryptography & Security Secrets
# ------------------------------------------------------------------------------
# HS256 JWT signing secret (min 32 chars, e.g. openssl rand -base64 48)
JWT_SECRET=replace_with_openssl_rand_base64_48

# AES-256-GCM encryption key for SMTP credentials & Slack tokens (64 hex chars, e.g. openssl rand -hex 32)
# CRITICAL: Back up this key offline! Losing it renders all stored SMTP and Slack tokens permanently unreadable.
ENCRYPTION_KEY=replace_with_openssl_rand_hex_32

# Comma-separated list of admin email addresses granted access to /admin and Bull Board
ADMIN_EMAILS=owner@example.com

# Mandatory production safety flag (must remain false; server refuses to boot if true)
ENABLE_FAULT_INJECTION=false

# ------------------------------------------------------------------------------
# 4. Third-Party OAuth Integrations
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Web Application Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://${DOMAIN}/auth/google/callback

# Slack App OAuth 2.0 Credentials (with incoming-webhook scope)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://${DOMAIN}/api/integrations/slack/callback

# ------------------------------------------------------------------------------
# 5. Core Scheduler & Queue Tuning
# ------------------------------------------------------------------------------
PORT=4000
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
MAX_EMAILS_PER_HOUR_GLOBAL=0
RATE_LIMIT_MODE=fixed
JITTER_PCT=15

# Retry & Circuit Breaker Settings
JOB_ATTEMPTS=3
JOB_BACKOFF_MS=5000
STALE_PROCESSING_MS=120000
BREAKER_FAILURES=5
BREAKER_WINDOW_MS=60000
BREAKER_COOLDOWN_MS=120000
